# --- Base (required) ---
BASE_RPC_URL=https://mainnet.base.org
# New Aero AERO token on Base (source: app.aero.xyz/docs/security)
AERO_TOKEN_BASE=0x3f5bF3EdAc59d650D8fDf9657a71F2f904A3a4Ee
# New AERO launched fully pre-minted (~2.12B), so migration doesn't add supply.
# Leave MIGRATION_MODE=0. (Legacy AERO: 0x940181a94A35A4569E4529A3CDfB74e38FD98631)
MIGRATION_MODE=0

# Optional: Aero Foundation wallet (receives the 5% contributor mint)
AERO_FOUNDATION_ADDRESS=

# --- xAERO receipt tokens (source: app.aero.xyz/docs/security) ---
XAERO_BASE=0x6CdDa0E730744DC6fF67654B35350Adad05EceE7
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
XAERO_ETHEREUM=0x9e148C5716b5aAdCFD3B71cEAE9EE7a9e22C29E2
OPTIMISM_RPC_URL=https://mainnet.optimism.io
XAERO_OPTIMISM=0xbdEaeA5205d16f34Cb40038052d91235D87B4C54
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
XAERO_ARBITRUM=0x436a085B2751cB87db270FFa66f8d698F87bEC82
INK_RPC_URL=https://rpc-gel.inkonchain.com
XAERO_INK=0x9e148C5716b5aAdCFD3B71cEAE9EE7a9e22C29E2
# Fill in when you have public RPC URLs for these chains:
ROBINHOOD_RPC_URL=
XAERO_ROBINHOOD=0x9e148C5716b5aAdCFD3B71cEAE9EE7a9e22C29E2
ARC_RPC_URL=
XAERO_ARC=0x20077cC0d5E385A0Fe9C91bbC7DC744f51559307

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Thresholds (annualized) ---
INFLATION_WATCH=0.08
INFLATION_BROKEN=0.12

# --- Emissions source (pick one) ---
# Free: a URL to the Dromos Kitchen emissions data, OR a local file path such as
# data/emissions.csv (download "CSV" from the dashboard's Emissions chart and save it there)
EMISSIONS_CSV_URL=https://dromos.kitchen/api/live/aero-launch
# Paid: Dune API key
DUNE_API_KEY=
DUNE_QUERY_ID=8980735
# Optional overrides if auto-detection picks the wrong columns (see --check-dune)
DUNE_DATE_COL=
DUNE_USD_COL=
DUNE_AERO_COL=
