# --- Base (required) ---
BASE_RPC_URL=https://mainnet.base.org
# AERO token on Base. Verify on basescan / aero.xyz docs before trusting it.
# Old Aerodrome AERO was 0x940181a94A35A4569E4529A3CDfB74e38FD98631 — run --check;
# if the merger deployed a new token, replace this.
AERO_TOKEN_BASE=0x940181a94A35A4569E4529A3CDfB74e38FD98631

# Optional: Aero Foundation wallet (receives the 5% contributor mint)
AERO_FOUNDATION_ADDRESS=

# --- xAERO on other chains (optional, add as you find the addresses) ---
# Without these, the bot counts Base supply only, which understates inflation
# by whatever xAERO LPs claimed and haven't bridged back yet.
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
XAERO_ETHEREUM=
OPTIMISM_RPC_URL=https://mainnet.optimism.io
XAERO_OPTIMISM=
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
XAERO_ARBITRUM=
INK_RPC_URL=
XAERO_INK=
ROBINHOOD_RPC_URL=
XAERO_ROBINHOOD=
ARC_RPC_URL=
XAERO_ARC=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Thresholds (annualized) ---
INFLATION_WATCH=0.08
INFLATION_BROKEN=0.12
